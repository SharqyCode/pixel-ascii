# Backend settings template.
# Copy to backend/.env.dev and backend/.env.prod, then fill in your own values.

# Secret used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection. Host ascii-db is the Compose service name; use localhost
# for a local run without Docker. Percent-encode special characters in the password
# (for example @ becomes %40). USER, PASSWORD, and DBNAME must match db/.env.dev.
DATABASE_URL=postgresql://USER:PASSWORD@ascii-db:5432/DBNAME
